# brain-server, for the NAS's container manager.
#
#   podman build -f server/Containerfile -t brain-server .
#   podman run -d --name brain-server \
#     -e BRAIN_VECTORS_TOKEN="$(openssl rand -hex 32)" \
#     -v brain-server:/var/lib/brain-vectors \
#     -p 8082:8082 brain-server
#
# The volume holds both the vector cache and `vault/`, which is real Markdown:
# whatever backs up that volume backs up the notes, and `git init` inside
# `vault/` gives history for free.
#
# Built from the workspace root, because the server depends on brain-core by
# path and a build context of `server/` alone cannot see it.

FROM docker.io/library/rust:1.83-slim AS build
WORKDIR /src
# The manifests first, so a change to the sources does not re-resolve the
# dependency graph. The core's sources come along because the server depends on
# it by path and cargo will not plan without them.
COPY Cargo.toml Cargo.lock ./
COPY core/Cargo.toml core/Cargo.toml
COPY server/Cargo.toml server/Cargo.toml
COPY core/src core/src
COPY server/src server/src
# Only the server. Building the workspace would pull in the GTK shell, which
# wants libadwaita and has no business in a headless image.
RUN cargo build --release --locked --package brain-server

FROM docker.io/library/debian:bookworm-slim
# Nothing is built here and nothing is downloaded at runtime, so the image
# needs no package manager state.
RUN rm -rf /var/lib/apt/lists/*
# An unprivileged user: the only thing written is the data volume, and root is
# not needed to write that.
#
# **The uid is fixed at 10001 on purpose and the host has to match it.** With a
# bind mount — which is what you want here, so the notes are a folder you can
# see, back up and `git init` — the kernel checks this uid against the host
# directory's owner, and a mismatch is a container that starts, serves
# `/health`, and fails every write. On a Synology that means one command over
# SSH before the first run:
#
#     sudo chown -R 10001:10001 /volume1/docker/brain-server
#
# Changing the number here means changing it there.
RUN useradd --create-home --uid 10001 --user-group vectors \
    && mkdir -p /var/lib/brain-vectors \
    && chown vectors:vectors /var/lib/brain-vectors
COPY --from=build /src/target/release/brain-server /usr/local/bin/brain-server

USER vectors
VOLUME /var/lib/brain-vectors
EXPOSE 8082
ENV BRAIN_VECTORS_ADDR=0.0.0.0:8082 \
    BRAIN_VECTORS_DATA=/var/lib/brain-vectors

# `/health` needs no token, which is the reason it needs no token.
#
# Podman writes OCI images by default and OCI has no HEALTHCHECK, so this is
# silently dropped unless you build with `--format docker`. The compose file
# declares it again for that reason — belt and braces, and the compose one is
# what Container Manager actually shows you.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
    CMD ["/usr/local/bin/brain-server", "--health"]

ENTRYPOINT ["/usr/local/bin/brain-server"]
