# Copy to `.env` beside docker-compose.yml on the NAS and fill in.
# `.env` is gitignored: the token is the only thing standing between the
# tailnet and your notes.

# Where Container Manager pulls the image from — whatever deploy-server.sh
# printed when it pushed.
#
# Say "localhost" when the registry runs on this same NAS, even though you
# pushed to its network name. A registry stores repositories by name and not by
# hostname, so it is the same image, and Docker accepts a registry reached over
# localhost on plain HTTP without being configured to. Naming the NAS instead
# means editing the Docker daemon config over SSH for no gain.
#
# Pin the dated tag rather than :latest, so a restart cannot quietly change
# what is holding your notes.
BRAIN_SERVER_IMAGE=localhost:5050/brain-server:2026-08-04

# 32 characters or more, or the server refuses to start. Generate one with:
#     openssl rand -hex 32
BRAIN_VECTORS_TOKEN=

# The host folder holding vectors.json and vault/. Must exist and be owned by
# uid 10001 before the first run:
#     sudo mkdir -p /volume1/docker/brain-server
#     sudo chown -R 10001:10001 /volume1/docker/brain-server
BRAIN_SERVER_DATA=/volume1/docker/brain-server

# Which interface to listen on. Leave unset for all of them; set it to the
# NAS's Tailscale address to be reachable only over the tailnet, which is the
# arrangement this was built for — it speaks plain HTTP, so on a LAN the token
# travels in clear text.
#     tailscale ip -4
# BRAIN_BIND=100.x.y.z
